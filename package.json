{
  "name": "doc-codesome",
  "version": "1.0.0",
  "private": true,
  "description": "Codesome 平台使用文档站（Docsify）",
  "scripts": {
    "dev": "docsify serve . --port 3008",
    "serve:site": "node server.mjs",
    "baseline:refresh": "node scripts/baseline.mjs",
    "baseline:check": "node scripts/baseline.mjs --check",
    "backup:articles": "node scripts/backup-articles.mjs",
    "check:article-backup": "node scripts/backup-articles.mjs --verify --verify-source",
    "sync:cdc": "node scripts/sync-cdc.mjs",
    "generate:admin-config": "node scripts/generate-admin-config.mjs",
    "generate:titles": "node scripts/generate-title-map.mjs && node scripts/generate-admin-config.mjs",
    "check:cdc": "node scripts/sync-cdc.mjs --check",
    "check:provenance": "node scripts/sync-cdc.mjs --check",
    "check:titles": "node scripts/generate-title-map.mjs --check",
    "check:article-titles": "node scripts/check-article-title-contract.mjs",
    "check:admin": "node scripts/generate-admin-config.mjs --check",
    "check:cache": "node scripts/check-cache-versions.mjs",
    "check:runtime": "node scripts/check-public-runtime.mjs",
    "check:article-toc": "node --test scripts/article-toc.test.mjs",
    "check:rendered-titles": "node scripts/check-rendered-titles.mjs",
    "check:rendered-titles:browser": "node scripts/check-rendered-titles.browser.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:article-backup:manifest": "node scripts/backup-articles.mjs --verify",
    "check:cms": "npm run check:titles && npm run check:article-titles && npm run check:admin && npm run check:links && npm run check:images && npm run check:secrets",
    "review:cms": "node scripts/review-cms-changes.mjs",
    "check": "npm run baseline:check && npm run check:article-titles && npm run check:cache && npm run check:runtime && npm run check:article-toc && npm run check:rendered-titles && npm run check:rendered-titles:browser && npm run check:links && npm run check:images && npm run check:secrets",
    "check:ci": "npm run baseline:check && npm run check:article-titles && npm run check:cache && npm run check:runtime && npm run check:article-toc && npm run check:rendered-titles && npm run check:rendered-titles:browser && npm run check:links && npm run check:images && npm run check:secrets",
    "test:browser": "node --test scripts/doc-site-browser-verify.test.mjs",
    "test:admin-login": "node --test scripts/admin-login.browser.test.mjs",
    "test:title-pipeline": "node --test scripts/markdown-headings.test.mjs scripts/title-injector.test.mjs",
    "test:server": "node --test scripts/server-contract.test.mjs",
    "test:cache": "node --test scripts/check-cache-versions.test.mjs",
    "test:backup": "node tests/backup-articles.test.mjs",
    "test:baseline": "node --test tests/baseline.test.mjs scripts/cdc-provenance.test.mjs",
    "test:metadata": "node --test scripts/public-articles.test.mjs",
    "test:cms-review": "node --test scripts/review-cms-changes.test.mjs",
    "test": "npm run test:browser && npm run test:admin-login && npm run test:title-pipeline && npm run test:server && npm run test:cache && npm run test:metadata && npm run test:cms-review && npm run test:backup && npm run test:baseline"
  },
  "devDependencies": {
    "docsify-cli": "^4.4.4",
    "playwright": "1.62.1"
  }
}
