# Codesome 文档站 —— 追加到服务器上现有 Caddyfile 的站点片段
# 文档站进程由 PM2 托管（pm2 start ecosystem.config.js），监听 127.0.0.1:3009
# 把下面的块复制/合并进现有 Caddyfile，然后 caddy reload（或 systemctl reload caddy）

# 方式一：用域名访问（推荐，把 docs.example.com 换成你的域名，自动 HTTPS）
doc.codesome.ai {
	encode gzip zstd

	@cs_workbench_auth path /cs-workbench /cs-workbench/*
	basicauth @cs_workbench_auth {
		boss $2a$14$YEPJxz3EE6dNf/cf7x6v1OlliBXdr0v0R/Qudb5IhW7vSoHiOgoaW
	}

	@cs_workbench_root path /cs-workbench
	redir @cs_workbench_root /cs-workbench/ 308

	@cs_workbench path /cs-workbench/*
	handle @cs_workbench {
		uri strip_prefix /cs-workbench
		reverse_proxy 127.0.0.1:3010
	}

	handle {
		reverse_proxy 127.0.0.1:3009
	}
}

# 方式二：没有域名，用现有域名的子路径访问（放进那个域名的站点块里）
